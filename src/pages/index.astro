---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import heroImage from '../assets/hero-server-cabling.jpg';
import oasisRoute from '../assets/oasis-red-sea-route.png';
import omanSiteAerial from '../assets/oman-site-aerial.jpg';
import omanGrainSilos from '../assets/oman-grain-silos.jpg';
import omanGreenhouseRows from '../assets/oman-greenhouse-rows.jpg';
import omanGreenhouseCrops from '../assets/oman-greenhouse-crops.jpg';
import cambodiaCableLanding from '../assets/cambodia-cable-landing.jpg';
import cambodiaSmartFarming from '../assets/cambodia-smart-farming.jpg';
import cambodiaDataCentre from '../assets/cambodia-data-centre.jpg';

const solutions = [
  {
    number: '01',
    title: 'Connectivity Ecosystem',
    text: 'Integrated fibre, colocation, cooling, power, and grid services for the infrastructure that keeps the internet moving.',
    href: '/solutions#connectivity',
  },
  {
    number: '02',
    title: 'Tokenisation',
    text: 'A bridge between real-world assets, digital instruments, market infrastructure, and global participants.',
    href: '/solutions#tokenisation',
  },
  {
    number: '03',
    title: 'Smart Agriculture',
    text: 'Connected production, processing, and distribution systems designed to improve visibility across the food value chain.',
    href: '/solutions#agriculture',
  },
  {
    number: '04',
    title: 'Commodities Arbitrage and Storage Solutions',
    text: 'A coordinated approach to sourcing, storage, selective processing, distribution, and market access.',
    href: '/solutions#commodities',
  },
];

const projects = [
  {
    id: 'oasis-red-sea',
    number: '01',
    title: 'OASIS Red Sea Cable System',
    text:
      'The OASIS Red Sea Cable system is a 3,500km cable system with state-of-the-art repeatered technology, which aims to provide high-performance, low-latency DC-to-DC connectivity spanning the route of the Suez Canal. The project is managed by our subsidiary, Pervasive Data Communications Pte Ltd.',
    specs: [
      { label: 'Status', value: 'Funding Stage' },
      { label: 'Design Capacity', value: '32 x 20 Tbps' },
      { label: 'Landing Sites', value: 'Sharm El-Sheikh, Djibouti City, Salalah' },
    ],
    media: [
      {
        src: oasisRoute,
        alt: 'Route map of the OASIS Red Sea cable system from Sharm El-Sheikh through Djibouti City to Salalah.',
      },
    ],
  },
  {
    id: 'oman-alfalfa',
    number: '02',
    title: 'Oman Alfalfa Smart Farming and Agricultural Cooperative',
    text:
      'A smart agricultural and farming solution located in Al-Buraimi, Oman, using AI and drone-based technologies to reach a forecast production of up to approximately 138,000 tonnes of premium alfalfa hay and derivatives for livestock consumption and local partners within Oman and the greater GCC region.',
    specs: [
      { label: 'Status', value: 'Awaiting Deployment' },
      { label: 'Production Capacity (Phase 3)', value: '138,000 tonnes (approx.)' },
      { label: 'Farm Size and Location (Phase 1)', value: '1,600 ha, Al-Buraimi' },
    ],
    media: [
      { src: omanSiteAerial, alt: 'Satellite view of the Al-Buraimi site with the Phase 1 farm plot outlined.' },
      { src: omanGrainSilos, alt: 'Grain storage silos beside a cultivated field at sunset.' },
      { src: omanGreenhouseRows, alt: 'Rows of alfalfa growing under a covered greenhouse structure.' },
      { src: omanGreenhouseCrops, alt: 'Close view of young crops growing in raised beds inside a greenhouse.' },
    ],
  },
  {
    id: 'cambodia-connectivity',
    number: '03',
    title: 'Cambodia Connectivity and Smart Agriculture Solution',
    text:
      'Pervasive Capital plans a submarine optic fibre cable, data centre, and AI-based smart agricultural package to boost connectivity and digital productivity in the Kingdom of Cambodia. The plan covers fibre connectivity, cloud capacity and storage, and a proprietary digital farming platform developed with local farming collectives.',
    specs: [
      { label: 'Status', value: 'In Negotiations' },
      { label: 'Mission', value: 'Tier 4 Data Centre, Colo-aaS, Smart Contract Farming' },
      { label: 'Potential Cable Landing Sites', value: 'Phnom Penh, Cambodia' },
    ],
    media: [
      { src: cambodiaCableLanding, alt: 'Coastal cable landing station viewed from the water.' },
      { src: cambodiaSmartFarming, alt: 'A hand holding a phone running a smart farming app above planted field rows.' },
      { src: cambodiaDataCentre, alt: 'Aerial view of a large data centre campus.' },
    ],
  },
];
---

<SiteLayout
  title="Pervasive Capital"
  description="Pervasive Capital develops connected infrastructure and market systems across telecommunications, technology, agriculture, and commodities."
>
  <section class="hero">
    <Image
      class="hero-image"
      src={heroImage}
      alt=""
      loading="eager"
      format="webp"
      quality={82}
    />
    <div class="hero-overlay"></div>
    <div class="shell hero-content">
      <p class="eyebrow">Infrastructure · Technology · Markets</p>
      <h1>Building systems for a connected, resilient world.</h1>
      <p>
        Pervasive Capital develops practical infrastructure and market solutions across
        telecommunications, automation, asset management, and essential industries.
      </p>
      <div class="button-row">
        <a class="button hero-button" href="/solutions">Explore our solutions</a>
        <a class="text-link" href="/about">About Pervasive Capital <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="intro">
    <div class="shell intro-grid">
      <div>
        <p class="eyebrow">Our approach</p>
        <h2>Long-term thinking, grounded execution.</h2>
      </div>
      <div class="intro-copy">
        <p>
          Our solutions target both evergreen and emerging industries. We work with local
          partners to reduce execution risk, build informed market understanding, and create
          durable value.
        </p>
        <p>
          By connecting energy, technology, physical infrastructure, and market access,
          Pervasive Capital helps businesses pursue greater efficiency, versatility, and
          resilience in an increasingly complex world.
        </p>
        <a class="inline-link" href="/vision">Read our vision <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="solutions-preview" aria-labelledby="solutions-heading">
    <div class="shell">
      <div class="section-title">
        <div>
          <p class="eyebrow">What we build</p>
          <h2 id="solutions-heading">Four connected areas of focus.</h2>
        </div>
        <a class="button secondary" href="/solutions">View all solutions</a>
      </div>

      <div class="solution-grid">
        {solutions.map((solution) => (
          <a class="solution-card" href={solution.href}>
            <span class="card-number">{solution.number}</span>
            <h3>{solution.title}</h3>
            <p>{solution.text}</p>
            <span class="card-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="projects" aria-labelledby="projects-heading">
    <div class="shell">
      <div class="section-title">
        <div>
          <p class="eyebrow">Selected projects</p>
          <h2 id="projects-heading">Work in development.</h2>
        </div>
      </div>

      <div class="project-list">
        {projects.map((project, index) => (
          <article id={project.id} class:list={['project', index % 2 === 1 && 'reverse']}>
            <div class="project-media" data-count={project.media.length}>
              {project.media.map((item) => (
                <Image src={item.src} alt={item.alt} loading="lazy" format="webp" quality={80} />
              ))}
            </div>

            <div class="project-copy">
              <p class="eyebrow">Project {project.number}</p>
              <h3>{project.title}</h3>
              <p class="project-text">{project.text}</p>
              <dl class="spec-table">
                {project.specs.map((spec) => (
                  <div class="spec-row">
                    <dt>{spec.label}</dt>
                    <dd>{spec.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="shell cta-inner">
      <p class="eyebrow">Start a conversation</p>
      <h2>Looking for a long-term infrastructure or market partner?</h2>
      <a class="button" href="/contact">Contact Pervasive Capital</a>
    </div>
  </section>
</SiteLayout>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-height));
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--ink);
    color: var(--white);
  }

  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(7 29 43 / 93%) 0%, rgb(7 29 43 / 68%) 55%, rgb(7 29 43 / 25%) 100%),
      linear-gradient(0deg, rgb(7 29 43 / 68%), transparent 55%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding-block: clamp(5rem, 12vw, 9rem);
  }

  .hero .eyebrow {
    color: #7bd1cc;
  }

  .hero h1 {
    max-width: 56rem;
    margin-bottom: 1.5rem;
  }

  .hero-content > p:not(.eyebrow) {
    max-width: 42rem;
    margin-bottom: 2rem;
    color: #d4dedf;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .hero-button {
    border-color: var(--teal-bright);
    background: var(--teal-bright);
    color: var(--ink);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 0.25rem;
    color: var(--white);
    font-size: 0.9rem;
    font-weight: 750;
    text-underline-offset: 0.3rem;
  }

  .intro,
  .solutions-preview,
  .cta {
    padding: clamp(5rem, 10vw, 9rem) 0;
  }

  .intro {
    background: var(--cream);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .intro h2 {
    max-width: 35rem;
    margin-bottom: 0;
    color: var(--navy);
  }

  .intro-copy {
    max-width: 41rem;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .inline-link {
    color: var(--teal);
    font-weight: 750;
    text-underline-offset: 0.3rem;
  }

  .solutions-preview {
    background: var(--paper);
  }

  .section-title {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 3.5rem;
  }

  .section-title h2 {
    max-width: 42rem;
    margin-bottom: 0;
    color: var(--navy);
  }

  .solution-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .solution-card {
    position: relative;
    min-height: 21rem;
    padding: clamp(2rem, 4vw, 3.25rem);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: background 180ms ease, color 180ms ease;
  }

  .solution-card:hover {
    background: var(--navy);
    color: var(--white);
  }

  .card-number {
    color: var(--teal);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .solution-card h3 {
    max-width: 25rem;
    margin: 3.5rem 0 1rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.8rem, 3vw, 2.65rem);
    font-weight: 500;
  }

  .solution-card p {
    max-width: 29rem;
    margin-bottom: 0;
    color: var(--muted);
  }

  .solution-card:hover p,
  .solution-card:hover .card-number {
    color: #b9cdcf;
  }

  .card-arrow {
    position: absolute;
    right: 2rem;
    bottom: 1.75rem;
    color: var(--teal);
    font-size: 1.5rem;
  }

  .projects {
    padding: clamp(5rem, 10vw, 9rem) 0;
    background: var(--cream);
  }

  .project-list {
    display: grid;
    gap: clamp(4rem, 8vw, 7rem);
  }

  .project {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  .project.reverse .project-media {
    order: 2;
  }

  .project-media {
    display: grid;
    gap: 0.75rem;
  }

  .project-media img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--white);
  }

  .project-media[data-count='1'] img {
    aspect-ratio: auto;
    object-fit: contain;
  }

  .project-media[data-count='3'] {
    grid-template-columns: repeat(2, 1fr);
  }

  .project-media[data-count='3'] img:last-child {
    grid-column: span 2;
    aspect-ratio: 16 / 9;
  }

  .project-media[data-count='4'] {
    grid-template-columns: repeat(2, 1fr);
  }

  .project-copy h3 {
    margin: 0 0 1.25rem;
    color: var(--navy);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.6rem, 2.6vw, 2.35rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .project-text {
    margin-bottom: 2rem;
    color: var(--muted);
    font-size: 1.02rem;
  }

  .spec-table {
    margin: 0;
  }

  .spec-row {
    display: grid;
    grid-template-columns: minmax(9rem, 0.85fr) 1fr;
    gap: 1.5rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--line);
  }

  .spec-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .spec-row dt {
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .spec-row dd {
    margin: 0;
    color: var(--ink);
    font-weight: 600;
    text-align: right;
  }

  .cta {
    background: var(--teal);
    color: var(--white);
  }

  .cta-inner {
    max-width: 58rem;
    text-align: center;
  }

  .cta .eyebrow {
    color: #b8eeea;
  }

  .cta h2 {
    margin-bottom: 2.5rem;
  }

  .cta .button {
    border-color: var(--white);
    background: var(--white);
    color: var(--ink);
  }

  @media (max-width: 760px) {
    .hero {
      min-height: 44rem;
    }

    .hero-overlay {
      background: linear-gradient(90deg, rgb(7 29 43 / 92%), rgb(7 29 43 / 55%));
    }

    .intro-grid,
    .solution-grid {
      grid-template-columns: 1fr;
    }

    .section-title {
      align-items: start;
      flex-direction: column;
    }

    .solution-card {
      min-height: 19rem;
    }

    .project {
      grid-template-columns: 1fr;
    }

    .project.reverse .project-media {
      order: 0;
    }

    .spec-row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .spec-row dd {
      text-align: left;
    }
  }
</style>
